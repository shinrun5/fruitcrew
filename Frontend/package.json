{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-i18n.mjs && tsc -b && vite build",
    "build:capacitor": "node scripts/check-i18n.mjs && tsc -b && vite build --mode capacitor && cap sync",
