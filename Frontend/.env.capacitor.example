# Copy to .env.capacitor and fill in your real production API origin. Used
# only by `npm run build:capacitor` — the regular web build ignores this and
# stays same-origin (relative /api). Not secret; safe to commit for real, but
# ships as .example since the actual URL depends on where you've deployed.
VITE_API_BASE=https://your-production-domain.com/api

# Android push notifications: set to 1 only once android/app/google-services.json
# (from the Firebase console) is in place — without that file, turning push on
# crashes the Android app. iOS push needs no switch here.
VITE_FIREBASE_ENABLED=0
