<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- push notifications; App Store / TestFlight exports switch this to production -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- fruitcrew.app links open in the app (Backend/src/lib/appLinks.ts serves the matching file) -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:fruitcrew.app</string>
	</array>
</dict>
</plist>
