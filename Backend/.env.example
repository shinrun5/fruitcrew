# Copy to .env and fill in. .env is gitignored.

# Postgres (Supabase → Project Settings → Database → Connection string)
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (Supabase → Project Settings → API)
# Access tokens are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json,
# so no JWT secret is needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solver microservice (optional, defaults to http://localhost:8000)
SOLVER_URL=

# Transactional email via Resend (optional — without a key, emails are logged
# and skipped). EMAIL_FROM needs a domain you've verified in Resend before it
# can email anyone but the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=
# Optional — where replies to notification emails should land, if different
# from EMAIL_FROM's own address, e.g. you@gmail.com
EMAIL_REPLY_TO=
# Used in email links back to the app, e.g. https://fruitcrew.app — make sure
# this is spelled exactly right, it's baked into every "Open Fruit Crew" link
APP_URL=

# Scheduled jobs (Fri availability reminder, Sat/Sun auto-draft). Off unless "1".
CRON_ENABLED=
# IANA timezone for the cron schedules (default America/New_York)
CRON_TZ=

# WeChat Mini Program login (optional — MiniProgram/ only; without these, the
# /auth/wechat* routes 400 with "WeChat login is not configured"). APPID is
# also public in MiniProgram/project.config.json; APPSECRET must stay
# server-only — WeChat 公众平台 (mp.weixin.qq.com) → Development → Basic settings.
WECHAT_APPID=
WECHAT_APPSECRET=
