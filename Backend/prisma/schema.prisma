// Fruit Crew scheduler — see prisma/migrations for history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A company / multi-store owner. Every Store and User belongs to exactly one.
model Org {
  id             Int             @id @default(autoincrement())
  name           String
  ownerId        Int? // User id of the OWNER (plain column, no relation — like publishedById)
  createdAt      DateTime        @default(now())
  stores         Store[]
  users          User[]
  managerInvites ManagerInvite[]
}

// A shareable link an OWNER hands to someone they want running the company —
// a manager or co-owner — instead of the owner inventing a password for them.
// Mirrors Employee.inviteCode's shape, just for people who aren't staff.
model ManagerInvite {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  org          Org       @relation(fields: [orgId], references: [id])
  orgId        Int
  role         Role // OWNER or MANAGER
  storeIds     Int[]     @default([]) // MANAGER only; an OWNER gets the whole org
  createdById  Int // User id of the inviting owner (plain column, no relation)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime? // null = never expires (legacy rows predate this column)
  usedAt       DateTime?
  usedByUserId Int? // plain column, no relation — same pattern as createdById
}

// A small business asking to join, submitted from the public landing page.
// Nobody gets an account from this alone — a superadmin reviews it in Admin;
// approving creates the Org and emails the requester an OWNER invite link.
model SignupRequest {
  id           Int           @id @default(autoincrement())
  businessName String
  contactName  String
  email        String
  phone        String?
  message      String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById Int? // User id of the superadmin who approved/denied
  orgId        Int? // set on approval — the Org that was created
}

// The web-reachable "request my account be deleted" path App Store/Play both
// require alongside in-app deletion (see POST /auth/account for the in-app
// path a logged-in user can do themselves; this is for someone who'd rather
// not log in, or can't). status reuses RequestStatus: APPROVED means the
// superadmin fulfilled the deletion, DENIED means declined (e.g. no matching
// account, couldn't verify identity).
model AccountDeletionRequest {
  id           Int           @id @default(autoincrement())
  email        String
  reason       String?
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById Int? // User id of the superadmin who fulfilled/declined it
}

model Store {
  id                  Int                @id @default(autoincrement())
  name                String
  org                 Org                @relation(fields: [orgId], references: [id])
  orgId               Int
  // false => opening is not a gated skill here; every employee at this store
  // counts as an opener regardless of their EmployeeStore.canOpen flag
  requiresOpenerSkill Boolean            @default(true)
  // true => a NEW-tier worker is never scheduled solo on a window; the solver
  // keeps at least one REGULAR-or-above coworker on the same window with them
  pairNewWorkers      Boolean            @default(false)
  // false => this store doesn't use the Closing Duties feature at all (e.g. a
  // store too small to split up closing/bathroom/sweep/mop)
  tracksClosingDuties Boolean            @default(true)
  // default store hours, "HH:MM" 24h — the availability editor's quick-add
  // defaults ("+ all day" = open→close, "+ night" = nightStart→close). Null =
  // fall back to the span of the store's shift requirements. Per-weekday
  // exceptions live in StoreHours; dated exceptions in StoreHoliday.
  openTime            String?
  closeTime           String?
  nightStart          String?
  shiftRequirement    ShiftRequirement[]
  shifts              Shift[]
  employeeStores      EmployeeStore[]
  managers            ManagerStore[]
  schedule            Schedule?
  snapshots           ScheduleSnapshot[]
  editLog             ScheduleEditLog[]
  fixedShifts         FixedShift[]
  messages            Message[]
  messageReads        MessageRead[]
  weekdayHours        StoreHours[]
  holidays            StoreHoliday[]
  shiftNotes          ShiftNote[]
  closingDuties       ClosingDuty[]
  invite              StoreInvite?
}

// A reusable, store-scoped sign-up link — unlike ManagerInvite/Employee.inviteCode
// (each claimed once by one person), the same code here can be used by any number
// of different workers over time to self-register at this store. At most one per
// store (regenerating replaces the code, invalidating any copies already shared).
model StoreInvite {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  store       Store     @relation(fields: [storeId], references: [id])
  storeId     Int       @unique
  createdById Int // User id of the manager/owner who (re)generated it
  createdAt   DateTime  @default(now())
  expiresAt   DateTime? // null = never expires (legacy rows predate this column)
}

// A weekday whose hours differ from the store default (e.g. late Fridays, short
// Sundays). `closed` = the store isn't open that weekday at all. Null time +
// !closed means "same as the store default for that field".
model StoreHours {
  id         Int       @id @default(autoincrement())
  store      Store     @relation(fields: [storeId], references: [id])
  storeId    Int
  day        DayOfWeek
  closed     Boolean   @default(false)
  openTime   String?
  closeTime  String?
  nightStart String?

  @@unique([storeId, day])
}

// A specific date the store's hours differ (a holiday). `closed` (default) = no
// shifts generated for that date's weekday when it falls in the scheduled week.
model StoreHoliday {
  id         Int      @id @default(autoincrement())
  store      Store    @relation(fields: [storeId], references: [id])
  storeId    Int
  date       DateTime // UTC midnight
  label      String?
  closed     Boolean  @default(true)
  openTime   String?
  closeTime  String?
  nightStart String?

  @@unique([storeId, date])
  @@index([storeId, date])
}

// A standing weekly assignment: this employee always works this store/day/window.
// The generator writes it verbatim and solves only the remaining need (see
// lib/scheduleGen.ts). Manager-managed on the Workers screen.
model FixedShift {
  id         Int       @id @default(autoincrement())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId Int
  store      Store     @relation(fields: [storeId], references: [id])
  storeId    Int
  day        DayOfWeek
  start      DateTime // 1970-01-01 wall-clock, like Shift
  end        DateTime
  createdAt  DateTime  @default(now())

  @@unique([employeeId, storeId, day, start, end])
  @@index([storeId])
}

// Which stores a MANAGER user runs (a manager can cover several).
model ManagerStore {
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  store   Store @relation(fields: [storeId], references: [id])
  storeId Int

  @@id([userId, storeId])
  @@index([storeId])
}

model ShiftRequirement {
  id              Int       @id @default(autoincrement())
  store           Store     @relation(fields: [storeId], references: [id])
  storeId         Int
  day             DayOfWeek
  start           DateTime
  end             DateTime
  managerRequired Int       @default(0)
  seniorRequired  Int       @default(0)
  regularRequired Int       @default(0)
  newRequired     Int       @default(0)
  // at least one assigned employee must be flagged canOpen
  needOpen        Boolean   @default(false)
  // availability may begin this many minutes after `start` and still count
  // (e.g. 60 for night shifts where a late arrival is fine)
  graceMinutes    Int       @default(0)
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// One per store: that store's current working schedule. `publishedAt` gates whether
// its employees can see it; `weekStart` (a Monday, midnight UTC) is the calendar week
// it covers -- shifts stay day-of-week templated, this is just the dates shown.
model Schedule {
  id               Int       @id @default(autoincrement())
  store            Store     @relation(fields: [storeId], references: [id])
  storeId          Int       @unique
  publishedAt      DateTime?
  publishedById    Int?
  // the DRAFT / edit-focus week — what the manager's board is currently pointed
  // at. May differ from postedWeekStart while a later week is being drafted;
  // the posted week's own Shift rows stay live and untouched until published.
  weekStart        DateTime?
  // which week's live Shift rows are posted/visible to employees. Set on
  // publish; OUTLIVES a later draft/regenerate of a *different* week, so
  // workers keep seeing (and can act on) the last posted week until the
  // manager posts the next one. Not cleared on unpublish (the manager will
  // likely republish the same week shortly).
  postedWeekStart  DateTime?
  // the ScheduleSnapshot employees currently see. Set on publish, and it OUTLIVES
  // a later draft/regenerate — so workers keep seeing the last posted week until
  // the manager posts the next one. Cleared on unpublish. (plain column, no FK)
  postedSnapshotId Int?
  updatedAt        DateTime  @updatedAt
}

// A frozen copy of one store's working schedule, kept for history. Self-contained:
// shift rows carry denormalised employee names so old weeks still render after the
// roster changes. `storeId` null = a legacy pre-multi-store snapshot.
model ScheduleSnapshot {
  id        Int      @id @default(autoincrement())
  store     Store?   @relation(fields: [storeId], references: [id])
  storeId   Int?
  weekStart DateTime
  label     String?
  savedAt   DateTime @default(now())
  savedById Int?
  shifts    Json // [{ employeeId, employeeName, storeId, storeName, day, start, end }]
}

// One row per retroactive edit — a manager restoring/changing a week whose
// dates have already passed (see POST /schedule/snapshots/:id/restore). Not
// written for ordinary draft/future-week edits, only for the case the
// frontend warns about, so this stays a record of after-the-fact changes for
// dispute resolution (e.g. "did anyone touch this after it was worked").
model ScheduleEditLog {
  id         Int      @id @default(autoincrement())
  store      Store    @relation(fields: [storeId], references: [id])
  storeId    Int
  weekStart  DateTime
  editedAt   DateTime @default(now())
  editedById Int

  @@index([storeId, weekStart])
}

model Shift {
  id             Int                  @id @default(autoincrement())
  employee       Employee?            @relation(fields: [employeeId], references: [id])
  employeeId     Int?
  store          Store                @relation(fields: [storeId], references: [id])
  storeId        Int
  // Monday, UTC midnight — which calendar week this row belongs to. Lets a
  // posted week and a next-week draft coexist as separate live rows instead
  // of one destroying the other (see scheduleGen.ts).
  weekStart      DateTime
  day            DayOfWeek
  start          DateTime
  end            DateTime
  changeRequests ShiftChangeRequest[]

  @@index([storeId, weekStart])
  @@index([employeeId, weekStart])
}

enum ChangeType {
  DROP // give up my shift -> it becomes unassigned
  SWAP // hand my shift to a specific coworker
  PICKUP // claim an unassigned shift
}

enum RequestStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

// An employee-initiated change to a posted shift, awaiting manager approval.
// A SWAP or DROP with openOffer = true is a marketplace post: no target until a
// coworker claims it (which sets targetEmployeeId) or a counteroffer is accepted;
// still PENDING until the manager approves.
model ShiftChangeRequest {
  id               Int                 @id @default(autoincrement())
  type             ChangeType
  status           RequestStatus       @default(PENDING)
  openOffer        Boolean             @default(false)
  shift            Shift               @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftId          Int
  requestedBy      Employee            @relation("RequestsMade", fields: [requestedById], references: [id])
  requestedById    Int
  targetEmployee   Employee?           @relation("RequestsTargeted", fields: [targetEmployeeId], references: [id])
  targetEmployeeId Int?
  // when set, only this slice of the shift is being handed off (1970 wall-clock,
  // like Shift.start/end). null = the whole shift. On approval the shift is split.
  handoffStart     DateTime?
  handoffEnd       DateTime?
  note             String?
  createdAt        DateTime            @default(now())
  resolvedAt       DateTime?
  resolvedById     Int? // User id of the manager who approved/denied
  counterOffers    ShiftCounterOffer[]

  @@index([shiftId])
  @@index([requestedById])
  @@index([status])
}

// A coworker's proposal to cover only PART of an open marketplace post's window
// (e.g. the post offers 4pm-11pm, they can only do 4pm-8pm). The poster (or a
// manager) accepts one, which copies its employee/window onto the parent
// request's targetEmployeeId/handoffStart/handoffEnd — the actual Shift split
// still only ever happens via the existing POST /:id/approve step.
model ShiftCounterOffer {
  id         Int                @id @default(autoincrement())
  request    ShiftChangeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId  Int
  employee   Employee           @relation("CounterOffersMade", fields: [employeeId], references: [id])
  employeeId Int
  start      DateTime // proposed coverage window, 1970 wall-clock like Shift.start
  end        DateTime
  note       String?
  status     RequestStatus      @default(PENDING)
  createdAt  DateTime           @default(now())
  resolvedAt DateTime?

  @@index([requestId])
}

model Employee {
  id                        Int                        @id @default(autoincrement())
  name                      String
  phone                     String? // contact number; mirrored to/from User.phone when an account is linked
  shift                     Shift[]
  hourLimit                 Int
  maxShifts                 Int                        @default(6) // max distinct days worked per week
  standby                   Boolean                    @default(false) // on-call: never auto-scheduled, only manually assignable
  avatarFruit               String? // chosen fruit avatar; null -> a deterministic default by id. Unique per store (see routes/employees.ts).
  // "one of these days only" groups, e.g. [["SATURDAY","SUNDAY"]] = schedule at most
  // one of Sat/Sun. DayOfWeek[][]; the solver adds sum(worked[d] in group) <= 1.
  eitherOrDays              Json?
  // true => the solver never puts this person on two back-to-back days in a week
  noConsecutiveDays         Boolean                    @default(false)
  employeeStores            EmployeeStore[]
  recurringAvailability     RecurringAvailability[]
  weekAvailability          WeekAvailability[]
  availabilityConfirmations AvailabilityConfirmation[]
  timeOff                   TimeOffRequest[]
  fixedShifts               FixedShift[]
  changeRequestsMade        ShiftChangeRequest[]       @relation("RequestsMade")
  changeRequestsTargeted    ShiftChangeRequest[]       @relation("RequestsTargeted")
  counterOffersMade         ShiftCounterOffer[]        @relation("CounterOffersMade")
  // account link: an Employee starts with no login; a manager issues an
  // inviteCode, the person registers with it, and a User row gets linked here
  user                      User?
  inviteCode                String?                    @unique
  inviteCodeExpiresAt       DateTime? // null = no code issued, or a legacy code that predates this column
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

// Our own identity row. `authId` is the only reference to Supabase Auth --
// every app relation hangs off User.id so the auth provider can be swapped
// without re-modelling anything.
model User {
  id                         Int             @id @default(autoincrement())
  authId                     String          @unique // Supabase auth.users.id (UUID)
  email                      String          @unique
  // set once this login connects its WeChat account (MiniProgram/) — lets a
  // return visit re-authenticate via wx.login()'s openid instead of a
  // password. Linking always happens from an already-logged-in session
  // (POST /auth/wechat/link); nothing can self-register through this alone.
  wechatOpenId               String?         @unique
  name                       String? // display name; mirrored to Employee.name when linked
  phone                      String? // contact number, free-form
  role                       Role            @default(EMPLOYEE)
  // platform-level flag, independent of role/org — read-only cross-org oversight
  // for whoever operates the hosting. Not self-serve; set by hand for support.
  isSuperAdmin               Boolean         @default(false)
  // false only for an EMPLOYEE who self-registered via Employee.inviteCode or a
  // StoreInvite link (their identity is unverified until a manager/owner reviews
  // them). Defaults true so every other creation path (register-manager,
  // register-owner, and legacy rows) needs no change — see requireAuth's
  // pending-approval gate in lib/auth.ts.
  approved                   Boolean         @default(true)
  // manager opt-in: get pinged when a worker changes a future week's availability
  notifyOnAvailabilityUpdate Boolean         @default(false)
  // opt-out: email me when a coworker posts a shift to the marketplace (default on)
  notifyOnMarketplacePost    Boolean         @default(true)
  // opt-in: email me when there are new store-chat messages I haven't seen
  notifyOnChatMessage        Boolean         @default(false)
  // opt-out: email me when someone @-mentions me in chat (default on — it's
  // directed at you specifically, unlike the general chat nudge above)
  notifyOnMention            Boolean         @default(true)
  lastChatEmailAt            DateTime? // rate-limits the chat digest email
  org                        Org?            @relation(fields: [orgId], references: [id])
  orgId                      Int?
  employee                   Employee?       @relation(fields: [employeeId], references: [id])
  employeeId                 Int?            @unique
  managerStores              ManagerStore[]
  notifications              Notification[]
  messages                   Message[]
  messageReads               MessageRead[]
  shiftNotesAuthored         ShiftNote[]     @relation("ShiftNotesAuthored")
  shiftNotesResolved         ShiftNote[]     @relation("ShiftNotesResolved")
  dmSent                     DirectMessage[] @relation("DmSent")
  dmReceived                 DirectMessage[] @relation("DmReceived")
  createdAt                  DateTime        @default(now())
}

// A 1-to-1 private message between two logins who share a store. No channel/thread
// row — a conversation is just every DirectMessage between the pair. `readAt` is
// set when the recipient has seen it (drives the unread badge).
model DirectMessage {
  id          Int       @id @default(autoincrement())
  sender      User      @relation("DmSent", fields: [senderId], references: [id])
  senderId    Int
  recipient   User      @relation("DmReceived", fields: [recipientId], references: [id])
  recipientId Int
  body        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([senderId, recipientId, id])
  @@index([recipientId, senderId, id])
}

// One store's group chat. Membership = anyone whose auth resolves this store
// (its employees, its managers, the org owner). Plain text only.
model Message {
  id         Int       @id @default(autoincrement())
  store      Store     @relation(fields: [storeId], references: [id])
  storeId    Int
  user       User?     @relation(fields: [userId], references: [id])
  userId     Int? // null once the author's account is removed
  authorName String // denormalised so old messages still render
  body       String
  mentions   Int[]     @default([]) // userIds @-mentioned in the body
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  @@index([storeId, id])
}

// How far through a store's chat one user has read (drives the unread badge).
model MessageRead {
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  store      Store    @relation(fields: [storeId], references: [id])
  storeId    Int
  lastReadAt DateTime @default(now())

  @@id([userId, storeId])
}

// Shift pass-down log: something the next shift should know (a refund coming
// back, a complaint, a found item, low stock…). Stays "open" until someone
// marks it done.
model ShiftNote {
  id            Int       @id @default(autoincrement())
  store         Store     @relation(fields: [storeId], references: [id])
  storeId       Int
  user          User?     @relation("ShiftNotesAuthored", fields: [userId], references: [id])
  userId        Int? // null once the author's account is removed
  authorName    String // denormalised
  category      String    @default("GENERAL") // GENERAL | REFUND | COMPLAINT | REMAKE | LOST_FOUND | STOCK | MAINTENANCE
  body          String
  // optional — only ever filled in for REFUND / COMPLAINT / REMAKE, where
  // knowing who/what/when matters for whoever picks the note up next
  issueAt       DateTime?
  customerName  String?
  customerPhone String?
  orderDetails  String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    User?     @relation("ShiftNotesResolved", fields: [resolvedById], references: [id])
  resolvedById  Int?
  resolvedName  String?

  @@index([storeId, resolvedAt, id])
}

enum NotificationKind {
  AVAILABILITY_REMINDER
  SCHEDULE_DRAFTED
  GENERIC
}

// In-app notification. Some also go out by email (see lib/notify.ts).
model Notification {
  id        Int              @id @default(autoincrement())
  user      User             @relation(fields: [userId], references: [id])
  userId    Int
  kind      NotificationKind @default(GENERIC)
  title     String
  body      String?
  link      String? // a client-side path, e.g. "/availability"
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, readAt])
}

// De-dupes scheduled jobs so a Fri run is a no-op if Thu already ran (and Sun
// after Sat). `key` is usually the target week (+ storeId for per-store jobs).
model JobRun {
  job   String
  key   String
  ranAt DateTime @default(now())

  @@id([job, key])
}

model RecurringAvailability {
  id         Int       @id @default(autoincrement())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId Int
  day        DayOfWeek
  start      DateTime
  end        DateTime

  @@index([employeeId])
}

// An employee's vacation / leave NOTICE — not an approval workflow. Filing it
// (>= 1 week long, >= 1 week ahead; enforced in routes/timeOff.ts) immediately
// takes the employee off the schedule for those days; the manager just gets a
// heads-up and can mark it seen. `cancelledAt` set = withdrawn.
model TimeOffRequest {
  id               Int       @id @default(autoincrement())
  employee         Employee  @relation(fields: [employeeId], references: [id])
  employeeId       Int
  startDate        DateTime // UTC midnight, inclusive
  endDate          DateTime // UTC midnight, inclusive
  note             String?
  createdAt        DateTime  @default(now())
  cancelledAt      DateTime?
  acknowledgedAt   DateTime? // a manager marked it "seen"
  acknowledgedById Int?

  @@index([employeeId])
}

// A one-week override of an employee's standing availability. If a row exists for
// (employeeId, weekStart) the solver uses `windows` for that week instead of the
// employee's RecurringAvailability. `windows`: [{ day, start:"HH:MM", end:"HH:MM" }]
// (an empty array = "can't work at all that week").
model WeekAvailability {
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId Int
  weekStart  DateTime // Monday, UTC midnight (matches Schedule.weekStart)
  windows    Json
  updatedAt  DateTime @updatedAt

  @@id([employeeId, weekStart])
}

// "I've checked my availability for this week" — set when an employee confirms
// their hours are right (or saves a one-week override). Lets a manager see who
// has responded to the weekly reminder before building that week's schedule.
model AvailabilityConfirmation {
  employee    Employee @relation(fields: [employeeId], references: [id])
  employeeId  Int
  weekStart   DateTime // Monday, UTC midnight
  confirmedAt DateTime @default(now())

  @@id([employeeId, weekStart])
}

enum Experience {
  NEW
  REGULAR
  SENIOR
  MANAGER
}

// One row per (store, week, day): who covers each post-close cleaning duty.
// Auto-filled from that day's closing crew (see lib/closingDuties.ts) the first
// time the week is opened, then manager-editable; "Regenerate" recomputes all 7
// days from scratch. Employee ids are plain columns (like Schedule.publishedById)
// — no FK, so removing an employee later doesn't need this table touched.
model ClosingDuty {
  id                  Int       @id @default(autoincrement())
  store               Store     @relation(fields: [storeId], references: [id])
  storeId             Int
  weekStart           DateTime
  day                 DayOfWeek
  closingEmployeeId   Int?
  bathroomEmployeeIds Int[]     @default([])
  sweepEmployeeId     Int?
  mopEmployeeId       Int?
  updatedAt           DateTime  @updatedAt

  @@unique([storeId, weekStart, day])
}

model EmployeeStore {
  employee    Employee   @relation(fields: [employeeId], references: [id])
  employeeId  Int
  store       Store      @relation(fields: [storeId], references: [id])
  storeId     Int
  proficiency Experience
  canOpen     Boolean    @default(false) // trusted to open the store (not tier-derived)
  canClose    Boolean    @default(false) // trusted to close/hold closing duties (not tier-derived)
  primary     Boolean    @default(true) // false = the solver only sends them here to close a gap

  @@id([employeeId, storeId])
  @@index([storeId])
}
