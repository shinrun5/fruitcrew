.shift-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.fruit-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFF8EC;
  border: 3px solid #3A2B4D;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.day-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFF8EC;
  border: 3px solid #3A2B4D;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 20rpx;
  flex-shrink: 0;
}
